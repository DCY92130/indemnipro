# ============================================================================
# ProIndemni — backend d'audit de contrat multirisque pro
# Copier ce fichier vers `.env` puis renseigner les valeurs.
# ============================================================================

# --- Obligatoire ---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# --- Optionnel (valeurs par défaut indiquées) ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.0

# Résilience
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_OUTPUT_RETRIES=1

# Garde-fou : taille max du texte envoyé au LLM (caractères).
# deepseek-chat = 64k tokens de contexte (~4 caractères/token en français).
MAX_INPUT_CHARS=180000

# CORS (origines séparées par des virgules, "*" pour tout autoriser en dev)
CORS_ORIGINS=*

# Anonymisation NER (Presidio / spaCy)
# fr_core_news_lg (571 Mo, qualite max) en local ;
# fr_core_news_md (~45 Mo) recommande pour un hebergement leger.
SPACY_MODEL=fr_core_news_lg

# ============================================================================
# ⚠️ RGPD : voir README.md. Pour des données de contrats réels, préférez un
# modèle hébergé dans l'UE (Mistral/Llama chez un hébergeur EU). Il suffit de
# changer DEEPSEEK_BASE_URL et DEEPSEEK_MODEL — le reste du code est inchangé.
# ============================================================================
